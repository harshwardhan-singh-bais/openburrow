# ===========================================================================
# OpenBurrow — environment template
# ===========================================================================
# Copy to `.env` and fill in.   cp .env.example .env
#
# Rules of the road
#   1. `.env` is git-ignored. `.env.example` is committed and must stay in sync.
#   2. Every variable below is OPTIONAL unless marked REQUIRED. OpenBurrow is
#      local-first: `uv tool install openburrow && burrow init` works with an
#      empty .env.
#   3. Precedence (highest first):
#         process env  >  .env  >  openburrow.yaml  >  built-in defaults
#      Config-file values live in `openburrow.yaml`; anything secret or
#      machine-specific lives here.
#   4. Nothing in this file is ever relayed off-machine unless it is explicitly
#      a relay/telemetry variable (see the RELAY and OBSERVABILITY sections).
#      Harness credentials stay on the machine that owns them — see
#      docs/governance/CREDENTIAL_ISOLATION.md.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. CORE / RUNTIME
# ---------------------------------------------------------------------------
# Prefix for every OpenBurrow variable. Keep as-is unless you are embedding
# the daemon inside another tool that already owns the OPENBURROW_ namespace.
OPENBURROW_ENV=development                  # development | staging | production
OPENBURROW_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
OPENBURROW_LOG_FORMAT=console               # console | json   (json in prod/CI)
OPENBURROW_LOG_FILE=                        # empty => stdout only
OPENBURROW_HOME=.openburrow                 # per-repo runtime dir (relative to repo root)
OPENBURROW_GLOBAL_HOME=                     # empty => ~/.openburrow (cross-repo state)
OPENBURROW_STATE_DIR=                       # overrides the resolved SQLite/socket dir
OPENBURROW_DEFAULT_REPO=                    # default repo when running outside a worktree
OPENBURROW_TIMEZONE=UTC                     # IANA name; used in audit timestamps
OPENBURROW_STRICT_CONFIG=false              # true => unknown YAML keys are a hard error
OPENBURROW_TELEMETRY=false                  # true => anonymous usage counters (opt-in)


# ---------------------------------------------------------------------------
# 2. DAEMON
# ---------------------------------------------------------------------------
OPENBURROW_DAEMON_HOST=127.0.0.1            # never bind 0.0.0.0 without a proxy
OPENBURROW_DAEMON_PORT=7317                 # JSON-RPC/HTTP control plane
OPENBURROW_DAEMON_SOCKET=                   # empty => <state_dir>/burrow.sock
                                            # Windows: \\.\pipe\openburrow-<user>-<repo-digest>
                                            # (12 hex chars: sha256 of the repo root, lowercased —
                                            #  the repo component is what lets two repos run two
                                            #  daemons; the dashboard derives it independently and
                                            #  scripts/check_endpoint_parity.py compares the two)
OPENBURROW_DAEMON_PIDFILE=                  # empty => <state_dir>/burrow.pid
OPENBURROW_DAEMON_AUTOSTART=false           # start on login (Stage 4 item 67)
OPENBURROW_DAEMON_MAX_CPU_PCT=50            # self-imposed CPU ceiling (Stage 4 item 66)
OPENBURROW_DAEMON_MAX_MEM_MB=1024           # self-imposed memory ceiling
OPENBURROW_DAEMON_SHUTDOWN_GRACE_S=15       # drain in-flight A2A tasks before exit
OPENBURROW_DAEMON_MULTI_REPO=true           # one daemon, many openburrow.yaml repos
OPENBURROW_API_VERSION=v1                   # control-plane API version (Stage 4 item 69)


# ---------------------------------------------------------------------------
# 3. DATABASE (local SQLite — the canonical append-only bus log lives here)
# ---------------------------------------------------------------------------
OPENBURROW_DB_URL=sqlite+aiosqlite:///.openburrow/burrow.db
OPENBURROW_DB_ECHO=false                    # log every SQL statement
OPENBURROW_DB_POOL_SIZE=5
OPENBURROW_DB_BUSY_TIMEOUT_MS=5000
OPENBURROW_DB_JOURNAL_MODE=WAL              # WAL is required for concurrent lanes
OPENBURROW_DB_MIGRATE_ON_START=true
OPENBURROW_DB_BACKUP_ON_MIGRATE=true
OPENBURROW_DB_RETENTION_DAYS=90             # prune bus events older than this (0 = keep forever)


# ---------------------------------------------------------------------------
# 4. A2A — AGENT2AGENT BUS  (THE CORE)
# ---------------------------------------------------------------------------
# OpenBurrow does not invent a wire format. Each lane is fronted by a small
# local A2A server so every harness looks like a standard A2A peer.
OPENBURROW_A2A_ENABLED=true
OPENBURROW_A2A_HOST=127.0.0.1
OPENBURROW_A2A_PORT_BASE=7400               # lane N listens on PORT_BASE + N
OPENBURROW_A2A_PORT_RANGE=200               # size of the allocatable lane port window
OPENBURROW_A2A_AGENT_CARD_PATH=/.well-known/agent-card.json
OPENBURROW_A2A_TRANSPORT=sse                # sse | streamable-http | json-rpc-only
OPENBURROW_A2A_PROTOCOL_VERSION=1.0
OPENBURROW_A2A_TASK_TIMEOUT_S=900           # per delegated task, wall clock
OPENBURROW_A2A_INPUT_REQUIRED_TIMEOUT_S=1800
OPENBURROW_A2A_AUTH_REQUIRED_TIMEOUT_S=3600
OPENBURROW_A2A_MAX_CONCURRENT_TASKS=8
OPENBURROW_A2A_MESSAGE_MAX_BYTES=262144     # 256 KiB — reject larger payloads
OPENBURROW_A2A_RATE_LIMIT_PER_MIN=60        # Stage 3 item 49 — stop looping negotiations
OPENBURROW_A2A_DEDUPE_WINDOW_S=30           # collapse identical re-sends
OPENBURROW_A2A_SIGN_MESSAGES=false          # true => sign with the local SSH key
OPENBURROW_A2A_VERIFY_PROVENANCE=false      # Stage 14 item 187 — impersonation defense
OPENBURROW_A2A_EXTERNAL_PEERS=              # comma-separated Agent Card URLs, e.g.
                                            # https://partner.example/agent-card.json
OPENBURROW_A2A_CONFORMANCE_SUITE=true       # run A2A conformance checks in CI


# ---------------------------------------------------------------------------
# 5. MCP — TOOL ACCESS (passthrough, never mediated)
# ---------------------------------------------------------------------------
# OpenBurrow does NOT proxy tool calls a harness already makes over MCP.
# It only needs to know where the configs live so it can surface/validate them.
OPENBURROW_MCP_ENABLED=true
OPENBURROW_MCP_CONFIG_PATHS=.mcp.json,~/.config/mcp/servers.json
OPENBURROW_MCP_ALLOW_PASSTHROUGH=true
OPENBURROW_MCP_DENY_SERVERS=                # comma-separated server names to block
OPENBURROW_MCP_HEALTHCHECK_INTERVAL_S=60
OPENBURROW_MCP_TOOL_TIMEOUT_S=120


# ---------------------------------------------------------------------------
# 6. ACP — NEGOTIATION PERFORMATIVES (propose/accept/reject/counter/inform)
# ---------------------------------------------------------------------------
OPENBURROW_ACP_ENABLED=true
OPENBURROW_ACP_MAX_EXCHANGES=6              # cap before human escalation (item 137)
OPENBURROW_ACP_ESCALATE_AFTER=4             # raise input_required to all teammates
OPENBURROW_ACP_AUTO_ACCEPT_TRIVIAL=false    # never silently auto-accept a counter
OPENBURROW_ACP_DEFAULT_TIMEOUT_S=600


# ---------------------------------------------------------------------------
# 7. LLM PROVIDERS — used by Merge Radar judge, lesson classifier, plan fallback
# ---------------------------------------------------------------------------
# OpenBurrow routes every model call through LiteLLM, so any provider below can
# be swapped without touching code. Only set the keys you actually use.
OPENBURROW_LLM_ENABLED=true
OPENBURROW_LLM_DEFAULT_MODEL=gpt-4o-mini
OPENBURROW_LLM_JUDGE_MODEL=gpt-4o-mini      # Merge Radar pairwise conflict judge
OPENBURROW_LLM_CLASSIFIER_MODEL=gpt-4o-mini # lesson / brain-worthy classifier
OPENBURROW_LLM_PLANNER_MODEL=gpt-4o         # fallback plan generation
OPENBURROW_LLM_TEMPERATURE=0.0
OPENBURROW_LLM_MAX_TOKENS=2048
OPENBURROW_LLM_TIMEOUT_S=60
OPENBURROW_LLM_MAX_RETRIES=3
OPENBURROW_LLM_CACHE=true                   # cache judge verdicts keyed by content hash
OPENBURROW_LLM_BUDGET_USD_PER_SESSION=5.00  # hard stop; 0 disables the ceiling

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ORG_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com

# --- Google / Gemini ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure OpenAI ---
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_NAME=

# --- Local / self-hosted (Ollama, vLLM, LM Studio, llama.cpp) ---
OLLAMA_API_BASE=http://127.0.0.1:11434
VLLM_API_BASE=http://127.0.0.1:8000/v1
OPENBURROW_LLM_LOCAL_ONLY=false             # true => never call a remote provider

# --- Router / gateway (optional) ---
LITELLM_PROXY_URL=
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=


# ---------------------------------------------------------------------------
# 8. HARNESS ADAPTERS — per-harness credentials
# ---------------------------------------------------------------------------
# CREDENTIAL ISOLATION (Stage 5 item 83 / Stage 19 item 242): each lane gets its
# own env slice. A harness never sees another lane's keys. Leave a harness's
# vars empty to make that adapter unavailable rather than misconfigured.
OPENBURROW_ADAPTERS_ENABLED=opencode,claude-code,codex,crush
OPENBURROW_ADAPTER_DEFAULT=opencode
OPENBURROW_ADAPTER_STRUCTURED_OUTPUT=prefer  # prefer | require | never
OPENBURROW_ADAPTER_PARSE_FALLBACK=true       # regex + cheap-LLM black-box parsing
OPENBURROW_ADAPTER_HEALTHCHECK_ON_START=true
OPENBURROW_ADAPTER_VERSION_PIN=              # e.g. claude-code==1.2.3,codex==0.9.*
OPENBURROW_ADAPTER_CRASH_RESTART=backoff     # never | once | backoff | always
OPENBURROW_ADAPTER_MAX_RESTARTS=3
OPENBURROW_ADAPTER_OUTPUT_BUFFER_KB=1024
OPENBURROW_ADAPTER_TERM=xterm-256color

# --- OpenCode (reference implementation: headless HTTP server + official SDK) ---
OPENCODE_BIN=opencode
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_CONFIG_DIR=

# --- Claude Code ---
CLAUDE_CODE_BIN=claude
ANTHROPIC_MODEL=claude-sonnet-4-5
CLAUDE_CODE_USE_BEDROCK=0
CLAUDE_CODE_USE_VERTEX=0
CLAUDE_CODE_MAX_OUTPUT_TOKENS=

# --- Codex CLI ---
CODEX_BIN=codex
CODEX_HOME=
CODEX_MODEL=
CODEX_SANDBOX=workspace-write             # read-only | workspace-write | danger-full-access
CODEX_APPROVAL_POLICY=on-request          # untrusted | on-failure | on-request | never

# --- Crush (Go, multi-provider, MCP-native) ---
CRUSH_BIN=crush
CRUSH_CONFIG_DIR=
CRUSH_MODEL=

# --- Gemini / Antigravity ---
GEMINI_CLI_BIN=gemini
ANTIGRAVITY_BIN=

# --- Aider / Goose / OpenHands ---
AIDER_BIN=aider
AIDER_MODEL=
GOOSE_BIN=goose
OPENHANDS_BIN=
OPENHANDS_RUNTIME=local                   # local | docker | remote

# --- Custom / bring-your-own harness ---
OPENBURROW_CUSTOM_ADAPTER_DIR=.openburrow/adapters
OPENBURROW_CUSTOM_ADAPTER_TRUST=prompt    # prompt | allow | deny


# ---------------------------------------------------------------------------
# 9. GIT / WORKTREES
# ---------------------------------------------------------------------------
OPENBURROW_GIT_BIN=git
OPENBURROW_WORKTREE_ROOT=                 # empty => <repo>/.openburrow/worktrees
OPENBURROW_WORKTREE_CLEANUP=on-close      # on-close | on-session-end | never
OPENBURROW_WORKTREE_PRUNE_STALE_DAYS=7
OPENBURROW_BRANCH_PREFIX=burrow/
OPENBURROW_COMMIT_SIGNING=false
OPENBURROW_AGENTS_MD=AGENTS.md            # repo-level agent context (honored, not invented)
OPENBURROW_AGENTS_MD_MAX_BYTES=32768      # truncation guard when seeding the Brain


# ---------------------------------------------------------------------------
# 10. GOVERNANCE & DELEGATION-ACCOUNTABILITY (Stage 14 — the loophole layer)
# ---------------------------------------------------------------------------
OPENBURROW_GOVERNANCE_ENABLED=true
OPENBURROW_GOVERNANCE_REQUIRE_DELEGATION_AUTHORITY=true   # item 180
OPENBURROW_GOVERNANCE_AUTHORITY_INHERITANCE=bounded       # bounded | full | none
OPENBURROW_GOVERNANCE_MAX_DELEGATION_DEPTH=3              # item 185 (authority creep)
OPENBURROW_GOVERNANCE_ALLOW_REDELEGATION=false            # item 183
OPENBURROW_GOVERNANCE_CROSS_BOUNDARY_STRICT=true          # item 184
OPENBURROW_GOVERNANCE_VERIFY_CAPABILITY_CARDS=warn        # off | warn | enforce (item 186)
OPENBURROW_GOVERNANCE_LEDGER_RETENTION_DAYS=365           # 0 = never prune
OPENBURROW_GOVERNANCE_AUDIT_EXPORT_FORMAT=jsonl           # jsonl | csv | pdf-ready-html
OPENBURROW_GOVERNANCE_HUMAN_ID=                           # who is authorizing today
OPENBURROW_GOVERNANCE_HUMAN_EMAIL=
OPENBURROW_GOVERNANCE_ORG_ID=


# ---------------------------------------------------------------------------
# 11. POLICY, GUARDRAILS & SANDBOXING (Stage 13 — the pre-execution gate)
# ---------------------------------------------------------------------------
OPENBURROW_POLICY_FILE=.openburrow/policy.yaml
OPENBURROW_POLICY_ENFORCE=true            # false => log-only (dry run)
# `deny` here works only because ALLOWED_COMMANDS below is non-empty: the two
# together mean "deny everything not on the list". Setting `deny` with an empty
# allowlist denies every command, and `burrow governance policy show` says so.
# The shipped default is `allow`, with denial expressed through DENIED_COMMANDS
# and DENIED_PATHS and the risk tiers routing dangerous commands to a human.
OPENBURROW_POLICY_DEFAULT_ACTION=deny     # deny | allow
OPENBURROW_POLICY_ALLOWED_COMMANDS=git,npm,pnpm,uv,pytest,ruff,ls,cat,rg
OPENBURROW_POLICY_DENIED_COMMANDS=rm -rf /,curl|sh,chmod 777,wget|bash
OPENBURROW_POLICY_ALLOWED_PATHS=.
OPENBURROW_POLICY_DENIED_PATHS=.env,secrets/,~/.ssh,~/.aws,/etc
OPENBURROW_POLICY_BUDGET_TOKENS_PER_SESSION=2000000
OPENBURROW_POLICY_BUDGET_USD_PER_SESSION=5.00
OPENBURROW_POLICY_MAX_FILES_CHANGED_PER_STEP=200
OPENBURROW_SANDBOX_ENABLED=false          # true => wrap each lane's spawn in a sandbox
# The backend is a command prefix, except `process`. An unavailable backend
# REFUSES the lane rather than starting it unsandboxed — asking for a boundary
# and silently not getting one is worse than not asking. `burrow doctor` reports
# what the configured backend would actually enforce on this machine.
#
#   process     resource limits only (POSIX). No filesystem or network boundary.
#   bubblewrap  Linux. Read-only root, worktree writable, network namespace off.
#   firejail    Linux. Same shape, different tool.
#   seatbelt    macOS (sandbox-exec). Deny-by-default profile.
#   docker      Anywhere Docker runs. Needs SANDBOX_DOCKER_IMAGE below.
OPENBURROW_SANDBOX_BACKEND=process        # process | bubblewrap | firejail | docker | seatbelt
OPENBURROW_SANDBOX_CPU_LIMIT=2
OPENBURROW_SANDBOX_MEM_LIMIT_MB=2048
OPENBURROW_SANDBOX_NETWORK=deny           # deny | allowlist | allow
# `allowlist` is honoured only by the docker backend. bubblewrap, firejail and
# seatbelt can turn the network off or leave it on and cannot express "these
# hosts only", so they report the allowlist as unenforced rather than silently
# granting full egress — `burrow doctor` shows which is which.
OPENBURROW_SANDBOX_NETWORK_ALLOWLIST=api.openai.com,api.anthropic.com,registry.npmjs.org
# Required by the docker backend, and deliberately empty. There is no default:
# the harness has to run in an image that contains the harness, and picking one
# on your behalf would run your code in a container you never chose.
OPENBURROW_SANDBOX_DOCKER_IMAGE=
OPENBURROW_SECRETS_SCRUB_RELAY=true       # strip secrets from outbound A2A payloads (item 201)
OPENBURROW_SECRETS_SCAN_BEFORE_COMMIT=true # warn on leaked keys (item 247)


# ---------------------------------------------------------------------------
# 12. APPROVALS (Stage 14 — human-in-the-loop)
# ---------------------------------------------------------------------------
OPENBURROW_APPROVALS_ENABLED=true
OPENBURROW_APPROVALS_MODE=interactive     # interactive | auto-deny | auto-approve-safe
OPENBURROW_APPROVALS_TIMEOUT_S=900
OPENBURROW_APPROVALS_ON_TIMEOUT=deny      # deny | escalate | pause
OPENBURROW_APPROVALS_ANY_TEAMMATE=true    # any authorized teammate may respond
OPENBURROW_APPROVALS_RISK_TIER_FILE=.openburrow/risk-tiers.yaml
OPENBURROW_APPROVALS_CI_AUTO_DENY=true


# ---------------------------------------------------------------------------
# 13. BRAIN, LESSONS & CRDT
# ---------------------------------------------------------------------------
OPENBURROW_BRAIN_ENABLED=true
OPENBURROW_BRAIN_SCOPE=repo               # repo | org
OPENBURROW_BRAIN_INGEST_AGENTS_MD=true    # item 108 — seed from AGENTS.md
OPENBURROW_BRAIN_EXPORT_AGENTS_MD=true    # item 109 — write back for other tools
OPENBURROW_BRAIN_STALENESS_CHECK=true     # git-anchor superseded => flag (item 111)
OPENBURROW_BRAIN_EMBEDDINGS=false         # keyword first, embeddings later (item 114)
OPENBURROW_BRAIN_EMBEDDING_MODEL=text-embedding-3-small
OPENBURROW_LESSONS_ENABLED=true
OPENBURROW_LESSONS_SCOPE=session          # session | repo | org
OPENBURROW_LESSONS_MAX_PER_SESSION=200
OPENBURROW_LESSONS_TTL_DAYS=30            # 0 = never expire
OPENBURROW_CRDT_ENABLED=true
OPENBURROW_CRDT_BACKEND=yjs               # yjs (via pycrdt) — shared with the web app
OPENBURROW_CRDT_DOC=                       # empty => <state_dir>/brain.ydoc


# ---------------------------------------------------------------------------
# 14. MERGE RADAR (Stage 9)
# ---------------------------------------------------------------------------
OPENBURROW_RADAR_ENABLED=true
OPENBURROW_RADAR_CONFIDENCE_THRESHOLD=0.65  # item 136 — avoid negotiation fatigue
OPENBURROW_RADAR_RUN_BEFORE_CLAIM=true
OPENBURROW_RADAR_MAX_PAIRS_PER_ROUND=25
OPENBURROW_RADAR_CACHE_VERDICTS=true


# ---------------------------------------------------------------------------
# 15. SESSION REELS (Stage 11 — replay)
# ---------------------------------------------------------------------------
OPENBURROW_REEL_ENABLED=true
OPENBURROW_REEL_RECORD_CASTS=true         # asciinema-format terminal casts
OPENBURROW_REEL_CAST_DIR=.openburrow/casts
OPENBURROW_REEL_EXPORT_DIR=.openburrow/reels
OPENBURROW_REEL_MAX_BYTES_PER_LANE=52428800  # 50 MiB per lane before rotation
OPENBURROW_REEL_SIGN_EXPORTS=false        # signed shareable links
OPENBURROW_REEL_LINK_EXPIRY_HOURS=168     # 7 days; 0 = never expires
OPENBURROW_REEL_PUBLIC_BASE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# 16. OBSERVABILITY (Stage 16)
# ---------------------------------------------------------------------------
OPENBURROW_OTEL_ENABLED=false
OTEL_SERVICE_NAME=openburrow
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc          # grpc | http/protobuf
OTEL_TRACES_EXPORTER=otlp                 # otlp | console | none
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_SDK_DISABLED=false
OPENBURROW_METRICS_PROMETHEUS=false
OPENBURROW_METRICS_PORT=9464
# Loopback by default, and that is a security decision rather than a convenience.
# prometheus_client binds 0.0.0.0 when given no address, which would publish this
# machine's session ids, lane names, token spend and governance-flag counts to
# every host on the network. Set this only when a scrape target on another box is
# deliberate.
OPENBURROW_METRICS_HOST=127.0.0.1
JAEGER_ENDPOINT=http://127.0.0.1:16686
PROMETHEUS_URL=http://127.0.0.1:9090


# ---------------------------------------------------------------------------
# 17. NOTIFICATIONS & INTEGRATIONS (Stage 17)
# ---------------------------------------------------------------------------
OPENBURROW_NOTIFY_ENABLED=true
OPENBURROW_NOTIFY_DESKTOP=true
OPENBURROW_NOTIFY_ON=approval,negotiation-unresolved,session-done,governance-flag
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#openburrow
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
OPENBURROW_EMAIL_DIGEST=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=openburrow@localhost
SMTP_USE_TLS=true
OPENBURROW_HOOKS_FILE=.openburrow/hooks.yaml
OPENBURROW_WEBHOOK_SECRET=                # HMAC secret for inbound webhooks (item 229)

# --- GitHub ---
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPO=
OPENBURROW_GITHUB_PR_ON_COMPLETE=false
OPENBURROW_GITHUB_STATUS_CHECKS=false


# ---------------------------------------------------------------------------
# 18. RELAY — REMOTE TEAMMATES (Stage 18) & TENANCY
# ---------------------------------------------------------------------------
OPENBURROW_RELAY_ENABLED=false
OPENBURROW_RELAY_URL=ws://127.0.0.1:8080/ws
OPENBURROW_RELAY_TOKEN=                   # signed session token (item 245)
OPENBURROW_RELAY_ORG=
OPENBURROW_RELAY_WORKSPACE=default
OPENBURROW_RELAY_ROLE=member              # admin | member | viewer
OPENBURROW_RELAY_RECONNECT_MAX_S=60
OPENBURROW_RELAY_QUEUE_MAX=10000          # offline A2A queue depth
OPENBURROW_RELAY_PRIVATE_BY_DEFAULT=true  # nothing public (item 238)
OPENBURROW_RELAY_SHARE_BRAIN=false        # cross-workspace Brain/Lesson toggle (item 240)

# --- Relay server-side (only needed when self-hosting the relay) ---
OPENBURROW_RELAY_HOST=127.0.0.1            # loopback; use 0.0.0.0 only in a container
OPENBURROW_RELAY_PORT=8080
OPENBURROW_RELAY_DB_URL=postgresql+asyncpg://openburrow:openburrow@localhost:5432/openburrow
OPENBURROW_RELAY_DB_POOL_SIZE=10
OPENBURROW_RELAY_DB_MAX_OVERFLOW=20
OPENBURROW_RELAY_CORS_ORIGINS=http://localhost:3000
OPENBURROW_RELAY_TENANT_QUOTA_SESSIONS=50
OPENBURROW_RELAY_TENANT_QUOTA_LANES=200
OPENBURROW_RELAY_FAIR_SCHEDULING=true
OPENBURROW_RELAY_RATE_LIMIT_PER_MIN=600
OPENBURROW_RELAY_JWT_SECRET=              # REQUIRED in production
OPENBURROW_RELAY_JWT_ALG=HS256
OPENBURROW_RELAY_JWT_TTL_HOURS=12
OPENBURROW_RELAY_ALLOW_SIGNUP=false
OPENBURROW_RELAY_ALLOWED_ORIGINS=
OPENBURROW_RELAY_TRUST_PROXY=false

# --- Postgres (docker-compose convenience; also read by the relay) ---
POSTGRES_USER=openburrow
POSTGRES_PASSWORD=openburrow
POSTGRES_DB=openburrow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ---------------------------------------------------------------------------
# 19. SECURITY & AUTH (Stage 19)
# ---------------------------------------------------------------------------
OPENBURROW_AUTH_MODE=local                # local | ssh-key | github-device | jwt
OPENBURROW_SSH_KEY=~/.ssh/id_ed25519
OPENBURROW_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
OPENBURROW_SOCKET_MODE=0600               # local socket permission hardening (item 246)
OPENBURROW_GITHUB_DEVICE_FLOW=false
OPENBURROW_SESSION_TOKEN_TTL_HOURS=12
OPENBURROW_ALLOW_INSECURE_HTTP=false      # must be false outside development


# ---------------------------------------------------------------------------
# 20. CHAOS / FAULT INJECTION (Stage 20 — test-only, never enable in prod)
# ---------------------------------------------------------------------------
OPENBURROW_CHAOS_ENABLED=false
OPENBURROW_CHAOS_KILL_LANE_AFTER_S=0
OPENBURROW_CHAOS_DROP_RELAY_MESSAGES=0    # 0.0–1.0 probability
OPENBURROW_CHAOS_MALFORM_PLAN_OUTPUT=false
OPENBURROW_CHAOS_HANG_APPROVAL=false
OPENBURROW_CHAOS_SEED=1337


# ---------------------------------------------------------------------------
# 21. FRONTEND (Next.js) — apps/web
# ---------------------------------------------------------------------------
# Two surfaces: the Session Reel replay viewer and the optional relay/team
# dashboard (server-rendered).
#
# NEXT_PUBLIC_* values are baked into the browser bundle, so anyone who loads
# the page can read them. Nothing secret belongs in one, and the block below
# is the server-side counterpart.
#
# These four are the COMPLETE set `apps/web/src` reads. Note that two of them
# carry no `_URL` suffix, which is worth knowing before writing one from
# memory: Next bakes the literal name it finds in the source, so a variable
# named `NEXT_PUBLIC_OPENBURROW_API_URL` is read by nothing and fails with no
# error at all. Re-derive the list with:
#   grep -rhoE 'process\.env\.[A-Z_]+' apps/web/src | sort -u
NEXT_PUBLIC_OPENBURROW_API=               # empty => the Next route handlers proxy the daemon,
                                          # which is what keeps the control token out of the browser.
                                          # Set to the daemon's origin only if the browser can reach it.
NEXT_PUBLIC_OPENBURROW_THEME=             # light | dark; the theme until someone picks one in the
                                          # header. Empty => follow the OS preference.
NEXT_PUBLIC_OPENBURROW_POLL_MS=1000       # board and session refresh interval
NEXT_PUBLIC_OPENBURROW_FEED_LIMIT=500     # bus events fetched per refresh
#
# Deliberately absent, and listed so nobody re-adds them from memory: this file
# used to declare NEXT_PUBLIC_OPENBURROW_API_URL, NEXT_PUBLIC_RELAY_WS_URL,
# NEXT_PUBLIC_REEL_BASE_URL, NEXT_PUBLIC_APP_NAME, NEXT_PUBLIC_ENABLE_DASHBOARD,
# NEXT_PUBLIC_ENABLE_REPLAY_VIEWER, NEXT_PUBLIC_OTEL_ENDPOINT and
# REEL_EXPORT_MODE. Nothing in apps/web reads any of them, so setting one had no
# effect whatsoever. Wire the feature first, then add the variable.

# --- server-side only (never reaches the browser) --------------------------
# The daemon does not speak HTTP. Its control plane is newline-delimited
# JSON-RPC over a Unix socket or a Windows named pipe, so the Next route
# handlers are a socket bridge rather than a proxy. These variables tell the
# bridge where to find things, and they must be set on the server process —
# prefixing any of them with NEXT_PUBLIC_ would both break them and leak the
# socket path into the client bundle.
#
# OPENBURROW_REPO_ROOT anchors every relative path the bridge resolves,
#   including the runtime directory. Set it when the server's working
#   directory is not the repository root.
OPENBURROW_REPO_ROOT=
# OPENBURROW_HOME, OPENBURROW_GLOBAL_HOME and OPENBURROW_DAEMON_SOCKET are
#   shared with the CLI and the daemon, and are documented in section 2
#   (CORE PATHS). The bridge resolves the endpoint with the same precedence
#   the CLI uses, so the two cannot disagree about which daemon they mean.
#
# OPENBURROW_WEB_RELAY_URL is the relay's HTTP origin, used by the
#   /api/relay/* passthrough. Deliberately NOT the variable the CLI client
#   uses: that one is a ws:// endpoint including a /ws path, while this one
#   needs a plain origin the route handler can append to. One name for both
#   meanings would mean whichever loaded last silently won.
OPENBURROW_WEB_RELAY_URL=http://127.0.0.1:8080


# ---------------------------------------------------------------------------
# 22. TESTS / CI
# ---------------------------------------------------------------------------
OPENBURROW_E2E=0                          # 1 => run tests that spawn real harnesses
OPENBURROW_TEST_HARNESS=mock              # mock | opencode | claude-code
OPENBURROW_TEST_DB_URL=sqlite+aiosqlite:///:memory:
OPENBURROW_TEST_TIMEOUT_S=120
CI=false
COVERAGE_THRESHOLD=85


# ---------------------------------------------------------------------------
# 23. DISTRIBUTION / PACKAGING (Stage 21)
# ---------------------------------------------------------------------------
OPENBURROW_UPDATE_CHECK=true
OPENBURROW_UPDATE_CHANNEL=stable          # stable | beta | nightly
OPENBURROW_UPDATE_MANIFEST_URL=https://openburrow.dev/releases/manifest.json
OPENBURROW_UVX_MODE=false                 # true when running via `uvx openburrow`
PYINSTALLER_BUILD=false                   # single-file binary build flag
NUITKA_BUILD=false

# =============================================================================
# OpenBurrow web frontend
# =============================================================================
# Copy to `.env.local` and edit. Next.js loads `.env.local` automatically and it
# is gitignored, which is why the secrets live here rather than in `.env`.
#
# Only variables prefixed NEXT_PUBLIC_ reach the browser. Everything else stays
# server-side, and that boundary is the whole security story of this app: the
# browser talks to Next, Next talks to the daemon and the relay.
#
#   browser ──HTTP──▶ Next route handlers ──unix socket──▶ burrow daemon
#                                        ──HTTP─────────▶ openburrow relay
#
# -----------------------------------------------------------------------------
# Where the daemon is  (SERVER-SIDE ONLY — never NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# The daemon does not speak HTTP. Its control plane is newline-delimited
# JSON-RPC over a unix domain socket (POSIX) or a named pipe (Windows), because
# filesystem permissions are the access control and a socket at mode 0600 has no
# port to scan and no firewall rule to get wrong. The route handlers under
# src/app/api/ are the bridge; the browser never dials the daemon itself.
#
# Leave both blank to use the platform default:
#   POSIX    <repo>/.openburrow/burrow.sock
#   Windows  \\.\pipe\openburrow-<USERNAME>-<repo-digest>
#
# The trailing 12 hex characters are sha256 of the repo root, lowercased. They
# are not decoration: Windows refuses a second server on a pipe name that is
# already bound, so without the repo component the first repo to start a daemon
# would own the endpoint for the whole machine. This comment used to omit them,
# and the app's own implementation omitted them too — so the dashboard dialled a
# pipe no daemon had ever created and reported only "daemon unreachable".
# `scripts/check_endpoint_parity.py` now compares this derivation against
# BurrowPaths on every run.
#
# Set it explicitly when the daemon is not in the default place — a container, a
# systemd unit with a custom OPENBURROW_HOME, or a daemon started from another
# checkout. Mirrors BurrowPaths.ipc_endpoint in openburrow.core.paths.
OPENBURROW_DAEMON_SOCKET=

# Which repo the dashboard is looking at. Without this the app walks up from its
# own working directory looking for openburrow.yaml or .git, which is wrong
# whenever `next start` runs from somewhere that is not the repo. A dashboard
# that silently shows a *different* repo's sessions is worse than one that fails.
OPENBURROW_REPO_ROOT=

# Override the repo runtime directory. The daemon treats a relative value as
# relative to the repo root. Mirrors OPENBURROW_HOME in openburrow.core.paths.
OPENBURROW_HOME=

# Override `~/.openburrow`, which holds the machine identity and the daemon
# registry. Only needed on shared machines with per-user state directories.
OPENBURROW_GLOBAL_HOME=

# -----------------------------------------------------------------------------
# Where the relay is  (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# The relay is the one component that already speaks HTTP, so /api/relay/* is a
# transparent proxy rather than a bridge. Keeping the origin server-side means
# the relay can sit on a private network while the web app does not, and it
# removes a CORS preflight from every relay call.
#
# Deliberately NOT `OPENBURROW_RELAY_URL`. That name is the *client* setting the
# CLI uses to dial a relay, and its value is a WebSocket URL with a path
# (`ws://host:8787/ws`). This proxy needs an HTTP origin. Sharing the name means
# one of the two is silently wrong.
#
# Unset → the relay surfaces answer 503 with an explanation rather than a 404,
# because "no relay is configured" and "that endpoint does not exist" are
# different facts and the operator needs to know which one they are looking at.
OPENBURROW_WEB_RELAY_URL=

# -----------------------------------------------------------------------------
# Browser-visible configuration  (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# The relay's WebSocket origin. A Next route handler cannot proxy a long-lived
# bidirectional socket, so /stream and /doc are dialled by the browser directly
# and this value is necessarily public. It is an origin, not a credential —
# every frame is authenticated by the member's own token after the handshake.
#
# Must be ws:// or wss:// and must match the page's scheme: a wss:// page cannot
# open a ws:// socket, and browsers report that as a generic failure with no
# useful detail. Leave blank to disable the live-document surfaces.
NEXT_PUBLIC_OPENBURROW_RELAY_WS=

# Set to 1 to bypass the route handlers and talk to a daemon HTTP shim directly.
# Only meaningful for a static export (`OPENBURROW_WEB_STATIC=1`), where there is
# no server to proxy anything. Leave blank for every normal deployment.
NEXT_PUBLIC_OPENBURROW_API=

# -----------------------------------------------------------------------------
# Build shape
# -----------------------------------------------------------------------------
# Set to 1 to produce a static export (`out/`) instead of a server build. The
# reel player and the session board render statically, but the route handlers do
# not exist in that mode, so a static build can only reach the daemon if
# NEXT_PUBLIC_OPENBURROW_API points at something that speaks HTTP.
OPENBURROW_WEB_STATIC=0

# -----------------------------------------------------------------------------
# Display and pacing
# -----------------------------------------------------------------------------
# Default colour scheme, "light" or "dark". The UI follows the OS setting when
# this is unset; setting it pins the scheme and stops it tracking the OS.
NEXT_PUBLIC_OPENBURROW_THEME=

# How many bus events the client-side feed keeps before dropping the oldest. The
# daemon's log is the record; this is a view, and an unbounded view in a browser
# tab is a memory leak with a nice interface.
NEXT_PUBLIC_OPENBURROW_FEED_LIMIT=500

# How often the board polls, in milliseconds. The daemon does not push, so this
# is the resolution of the board. Below ~500ms it is wasted work — the daemon has
# nothing new to say; above ~5000ms it stops feeling live. Polling with
# `since_seq` is self-healing: a dropped tick is recovered by the next one.
NEXT_PUBLIC_OPENBURROW_POLL_MS=1000

# How many lanes' casts the reel viewer will decode at once. Each cast is parsed
# in the main thread, so this is the knob that trades first-paint latency against
# memory on a session with many lanes.
NEXT_PUBLIC_OPENBURROW_REEL_CONCURRENCY=3
